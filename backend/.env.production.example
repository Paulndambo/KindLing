# Django / production
APP_ENV=production
DEBUG=false
SECRET_KEY=replace-with-a-long-random-secret
DATABASE_URL=postgresql://kindling:replace-me@db-host:5432/kindling
DB_CONN_MAX_AGE=60
ALLOWED_HOSTS=api.example.com
CORS_ALLOWED_ORIGINS=https://app.example.com
CSRF_TRUSTED_ORIGINS=https://app.example.com
SECURE_SSL_REDIRECT=true

# SMTP (use the provider's values)
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=replace-me
EMAIL_HOST_PASSWORD=replace-me
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=Kindling <noreply@example.com>

# Frontend build-time configuration; set in the frontend hosting service
VITE_LEARNING_API_URL=https://api.example.com/api/learning/events/
VITE_API_BASE_URL=https://api.example.com
